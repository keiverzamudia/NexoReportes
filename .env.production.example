# ============================================================
# SAN LUIS — variables de entorno de PRODUCCIÓN (Docker + PostgreSQL).
# Copiar a `.env` en la raíz del repo en el servidor y completar.
# NUNCA versionar el `.env` real.
# ============================================================

# ---------- PostgreSQL (contenedor db) ----------
POSTGRES_USER=nexo
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_DB=nexo

# ---------- Aplicación ----------
NODE_ENV=production
LOG_LEVEL=info
# URL con la que los usuarios entran a la app (IP del servidor en la LAN).
APP_URL=http://172.16.1.85:4100
# Sin HTTPS: la cookie de sesión NO puede marcarse Secure.
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://172.16.1.85:4100

# ---------- Autenticación ----------
# Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Códigos de Profit con rol ADMIN (separados por coma).
ADMIN_PROFIT_CODES=KZAMU
DEFAULT_USER_ROLE=CONSULTA
PROFIT_USER_SYNC_ENABLED=true
PROFIT_USER_SYNC_HOUR=3

# ---------- Profit (SQL Server, SOLO LECTURA) ----------
PROFIT_DB_SERVER=SRVBDPROFITBK
PROFIT_DB_DATABASE=COR_A3
PROFIT_DB_USER=solicitudweb
PROFIT_DB_PASSWORD=
# IMPORTANTE: 'fixtures' devuelve datos de demostración. En producción: mssql.
PROFIT_DB_DIALECT=mssql
PROFIT_DB_REQUEST_TIMEOUT_MS=30000
PROFIT_DB_MAX_RETRIES=2
PROFIT_DB_AUTH_DATABASE=MasterProfit
PROFIT_VIEW_SOLICITUDES=dbo.Solicitudes_Pendientes_Clientes

# ---------- Sincronización ----------
SYNC_INTERVAL_SECONDS=0
# Reloj por dominio (segundos). Ejemplo:
# EXISTENCIAS=120,PEDIDOS=300,PEDIDOS_DETALLE=300,CLIENTES=3600,PRODUCTOS=21600,ALMACENES=86400
SYNC_SCHEDULE=
SYNC_SNAPSHOT_RETENTION=240
SYNC_PAGE_SIZE=5000
