# ============================================================
# CORPOAGRO — variables de entorno de PRODUCCIÓN (Docker + PostgreSQL).
# Copiar a `.env` en la raíz del repo en el servidor y completar.
# NUNCA versionar el `.env` real.
# ============================================================

# ---------- PostgreSQL (contenedor db) ----------
POSTGRES_USER=nexo
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_DB=nexo

# ---------- Aplicación ----------
NODE_ENV=production
LOG_LEVEL=info
# URL con la que los usuarios entran a la app (IP del servidor en la LAN).
APP_URL=http://172.16.1.85:4100
# Sin HTTPS: la cookie de sesión NO puede marcarse Secure.
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://172.16.1.85:4100

# ---------- Autenticación ----------
# Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Códigos de Profit con rol ADMIN (separados por coma).
ADMIN_PROFIT_CODES=KZAMU
DEFAULT_USER_ROLE=CONSULTA
PROFIT_USER_SYNC_ENABLED=true
PROFIT_USER_SYNC_HOUR=3

# ---------- Profit (SQL Server, SOLO LECTURA) ----------
PROFIT_DB_SERVER=SRVBDPROFITBK
PROFIT_DB_DATABASE=COR_A3
PROFIT_DB_USER=solicitudweb
PROFIT_DB_PASSWORD=
# IMPORTANTE: 'fixtures' devuelve datos de demostración. En producción: mssql.
PROFIT_DB_DIALECT=mssql
PROFIT_DB_REQUEST_TIMEOUT_MS=30000
PROFIT_DB_MAX_RETRIES=2
PROFIT_DB_AUTH_DATABASE=MasterProfit
PROFIT_VIEW_SOLICITUDES=dbo.Solicitudes_Pendientes_Clientes

# ---------- Escritura puntual en Profit (entrega + bloqueo) ----------
# Excepción controlada a la regla de solo lectura: SOLO dbo.cotiz_c.fec_venc y
# dbo.cotiz_c.aux01 (bloqueo al iniciar la carga en despacho).
# Queda ACTIVA por defecto cuando hay credenciales SQL; `false` es el kill
# switch explícito. El cambio se firma con el código de la sesión (co_us_mo).
PROFIT_WRITE_ENABLED=true
# Vacío = reutiliza PROFIT_DB_USER / PROFIT_DB_PASSWORD.
PROFIT_WRITE_USER=
PROFIT_WRITE_PASSWORD=
# true = valida todo pero NO escribe en Profit (solo para simulacros).
PROFIT_WRITE_DRY_RUN=false
PROFIT_WRITE_MAX_ORDERS=50

# ---------- Sincronización ----------
SYNC_INTERVAL_SECONDS=0
# Reloj por dominio (segundos). Ejemplo:
# EXISTENCIAS=120,PEDIDOS=300,PEDIDOS_DETALLE=300,CLIENTES=3600,PRODUCTOS=21600,ALMACENES=86400
SYNC_SCHEDULE=
SYNC_SNAPSHOT_RETENTION=240
SYNC_PAGE_SIZE=5000

# ---------- Reconciliación de pedidos (nota de entrega) ----------
ORDER_RECONCILE_ENABLED=true
ORDER_RECONCILE_SECONDS=300
ORDER_RECONCILE_DRY_RUN=false
ORDER_RECONCILE_BATCH_SIZE=200

# ---------- Limpieza de simulaciones de despacho ----------
# Fotos de vida corta (72 h sin uso). La hoja de despacho conserva nombre,
# foto y receta. DRY_RUN=true calcula sin borrar.
SCENARIO_CLEANUP_ENABLED=true
SCENARIO_CLEANUP_HOURS=72
SCENARIO_CLEANUP_INTERVAL_HOURS=6
SCENARIO_CLEANUP_DRY_RUN=false

# ---------- Forecast / metas ----------
# Snapshot local de `forecast.kg_mensual` para que el histórico no cambie si
# producción edita la meta después.
# Minutos entre capturas (0 = desactivado; también se puede forzar con
# POST /api/forecast/sales/capture).
FORECAST_TARGET_INTERVAL_MINUTES=60
# Horas de gracia para corregir la primera captura del mes (producción puede
# cargar la meta unos días después). Después queda congelada.
FORECAST_TARGET_GRACE_HOURS=72
