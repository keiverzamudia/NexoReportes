// ============================================================
// Nexo Producción — Esquema Prisma
//
// Desarrollo: SQLite  (provider = "sqlite", DATABASE_URL="file:./nexo.db")
// Producción: PostgreSQL (cambiar provider a "postgresql" y DATABASE_URL)
//
// Decisiones de portabilidad SQLite <-> PostgreSQL:
//  - NO se usan `enum` de Prisma (no soportados en SQLite): los estados
//    se modelan como String validados con @nexo/contracts (Zod) en la frontera.
//  - NO se usa `Json` (no soportado en SQLite): los contextos de auditoría se
//    guardan como String con JSON serializado.
//  - Cantidades: se usarán Decimal (NUMERIC en PostgreSQL) en los modelos de
//    dominio de las fases siguientes.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Autenticación y usuarios ----------
model User {
  id          String    @id @default(cuid())
  // Código del usuario en Profit (MasterProfit.dbo.VUSUARIOS). Es el vínculo
  // con la autenticación: la contraseña se valida SIEMPRE en Profit
  // (MasterProfit.dbo.autenticar); aquí no se guarda ninguna contraseña.
  profitCode  String    @unique
  displayName String
  // Roles: ADMIN | GERENCIA | PLANIFICADOR | ALMACEN | CONSULTA (validados en contracts)
  role        String    @default("CONSULTA")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  refreshTokens RefreshToken[]
  auditEvents   AuditEvent[]  @relation("AuditActor")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- Auditoría (inmutable desde operaciones ordinarias) ----------
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  context    String? // JSON serializado (portabilidad SQLite/PostgreSQL)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------- Configuración del sistema ----------
model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// ---------- Sincronización con Profit ----------
model SyncRun {
  id              String    @id @default(cuid())
  // Domain: PRODUCTOS | CLIENTES | PEDIDOS | EXISTENCIAS | ALMACENES
  domain          String
  // Status: EN_CURSO | EXITOSA | PARCIAL | ERROR
  status          String    @default("EN_CURSO")
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  recordsRead     Int       @default(0)
  recordsUpserted Int       @default(0)
  errorsCount     Int       @default(0)
  errorDetail     String?
  sourceRef       String? // referencia a la vista/consulta de origen usada

  errors SyncError[]
}

model SyncError {
  id         String   @id @default(cuid())
  runId      String
  run        SyncRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  entity     String?
  externalId String?
  message    String
  raw        String?
  createdAt  DateTime @default(now())

  @@index([runId])
}

// ============================================================
// Entidades normalizadas desde Profit (Fase 2 — Integración)
// Conservan el identificador externo de Profit y marcan bajas
// con removedAt (nunca se borra histórico por una sync).
// ============================================================

model Product {
  id           String    @id @default(cuid())
  externalCode String    @unique
  description  String
  uom          String    @default("SAC")
  family       String?
  // Línea y categoría del artículo en Profit (co_lin / co_cat).
  // `isProduction` = pertenece a la línea de producción (ABA = balanceados).
  line         String?
  category     String?
  isProduction Boolean   @default(false)
  // kg por unidad de venta (columna `relacion_empaque` de la vista real:
  // 35 = saco de 35 KG). Permite reportar totales en KG/TON.
  kgPerUom     Decimal?
  isActive     Boolean   @default(true)
  removedAt    DateTime?
  lastSyncedAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orderLines    SalesOrderLine[]
  inventoryLines InventorySnapshotLine[]
}

model Warehouse {
  id           String    @id @default(cuid())
  externalCode String    @unique
  name         String
  isActive     Boolean   @default(true)
  removedAt    DateTime?
  lastSyncedAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inventoryLines InventorySnapshotLine[]
}

model Customer {
  id           String    @id @default(cuid())
  externalCode String    @unique
  name         String
  // L1 EXCLUSIVOS | COR CORPORATIVO | L2 DISTRIBUIDORES | L3 MINORISTA (crudo de Profit)
  customerType String?
  vendor       String?
  isActive     Boolean   @default(true)
  removedAt    DateTime?
  lastSyncedAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders SalesOrder[]
}

model SalesOrder {
  id             String    @id @default(cuid())
  externalNumber String    @unique
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerCode   String?
  customerName   String?
  customerType   String?
  vendor         String?
  orderDate      DateTime?
  requestedDate  DateTime?
  // ABIERTO | CERRADO | CANCELADO | DESCONOCIDO (mapeo desde statusRaw de Profit)
  status         String    @default("ABIERTO")
  statusRaw      String?
  authorized     Boolean?
  isActive       Boolean   @default(true)
  removedAt      DateTime?
  lastSyncedAt   DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines SalesOrderLine[]

  @@index([requestedDate])
  @@index([status])
}

model SalesOrderLine {
  id          String      @id @default(cuid())
  orderId     String
  order       SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNumber  Int
  productCode String
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id])
  description String?
  uom         String?
  // Cantidades DECIMAL: Precisiones de negocio (SAC con decimales). En PostgreSQL = NUMERIC.
  quantity    Decimal     @default(0)
  // Pendiente puede ser negativo en Profit (sobre-compromiso); conservar el signo.
  pendingQty  Decimal     @default(0)
  // kg del renglón según la vista (`kg` = pendiente × relacion_empaque,
  // calculado en Profit; se persiste el valor crudo, no se recalcula).
  pendingKg   Decimal?
  // Almacenes que surten el renglón (texto crudo, p. ej. "Stock 68 / Stock 03")
  warehouses  String?

  @@unique([orderId, lineNumber])
  @@index([productCode])
}

// Fotografía coherente de inventario por ejecución de sincronización.
model InventorySnapshot {
  id      String   @id @default(cuid())
  takenAt DateTime @default(now())
  // 'mssql' | 'fixtures'
  source  String
  runId   String?

  lines InventorySnapshotLine[]
}

model InventorySnapshotLine {
  id            String           @id @default(cuid())
  snapshotId    String
  snapshot      InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  productCode   String
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id])
  warehouseCode String
  warehouseId   String?
  warehouse     Warehouse?       @relation(fields: [warehouseId], references: [id])
  qty           Decimal          @default(0)
  reservedQty   Decimal          @default(0)

  @@index([snapshotId])
  @@index([productCode])
}

// ============================================================
// Forca (pronóstico de producción).
//   Forecast      = cabecera por artículo/mes. `monthlyQty` guarda el valor
//                   de Profit (`xart_fore.kg_mes`) vigente cuando se editaron
//                   las semanas: sirve para detectar si Profit lo cambió.
//                   El mensual NO se captura en Nexo. `locked`/`lockedAt` se
//                   conservan por compatibilidad y ya no se usan.
//   ForecastWeek  = reparto por semana (bloques 1-7 / 8-14 / 15-21 / 22-fin)
//                   con una CANTIDAD editable. Por defecto = forca mensual / 4.
// ============================================================
model Forecast {
  id          String    @id @default(cuid())
  productCode String
  year        Int
  month       Int
  monthlyQty  Decimal   @default(0)
  locked      Boolean   @default(false)
  lockedAt    DateTime?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  weeks ForecastWeek[]

  @@unique([productCode, year, month])
  @@index([year, month])
}

model ForecastWeek {
  id         String   @id @default(cuid())
  forecastId String
  forecast   Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  // 1..4 = bloques de días 1-7, 8-14, 15-21, 22-fin.
  weekIndex  Int
  // Cantidad asignada a la semana (por defecto = forca mensual / 4).
  qty        Decimal  @default(0)

  @@unique([forecastId, weekIndex])
}
