// ============================================================
// Nexo Producción — Esquema Prisma
//
// Desarrollo: SQLite  (provider = "sqlite", DATABASE_URL="file:./nexo.db")
// Producción: PostgreSQL (cambiar provider a "postgresql" y DATABASE_URL)
//
// Decisiones de portabilidad SQLite <-> PostgreSQL:
//  - NO se usan `enum` de Prisma (no soportados en SQLite): los estados
//    se modelan como String validados con @nexo/contracts (Zod) en la frontera.
//  - NO se usa `Json` (no soportado en SQLite): los contextos de auditoría se
//    guardan como String con JSON serializado.
//  - Cantidades: se usarán Decimal (NUMERIC en PostgreSQL) en los modelos de
//    dominio de las fases siguientes.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Autenticación y usuarios ----------
model User {
  id          String    @id @default(cuid())
  // Código del usuario en Profit (MasterProfit.dbo.VUSUARIOS). Es el vínculo
  // con la autenticación: la contraseña se valida SIEMPRE en Profit
  // (MasterProfit.dbo.autenticar); aquí no se guarda ninguna contraseña.
  profitCode  String    @unique
  displayName String
  // Roles: ADMIN | GERENCIA | PLANIFICADOR | ALMACEN | CONSULTA (validados en contracts)
  role        String    @default("CONSULTA")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  auditEvents         AuditEvent[]  @relation("AuditActor")
  scenarios           DispatchScenario[]
  sheetsAssigned      DispatchSheet[] @relation("SheetAssignee")
  notifications       Notification[]  @relation("NotificationRecipient")
  permissionOverrides UserPermission[]
}

// ============================================================
// Roles y permisos (RBAC dinámico).
//
// · Role            = rol efectivo (ADMIN, GERENCIA… o uno nuevo).
// · RolePermission  = matriz módulo × acción del rol.
// · UserPermission  = excepción puntual del usuario sobre su rol
//                     (allowed=true concede, false deniega; gana la excepción).
//
// `baseRole` es la plantilla histórica: conserva la semántica fina de Despacho
// (bandeja compartida, reclamo, propiedad). La matriz manda en accesos.
// ADMIN es rol de sistema: no se edita ni se borra y siempre tiene todo.
// ============================================================
model Role {
  code        String           @id
  name        String
  description String?
  baseRole    String           @default("CONSULTA")
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
}

model RolePermission {
  roleCode String
  role     Role   @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  module   String
  action   String

  @@id([roleCode, module, action])
  @@index([module, action])
}

model UserPermission {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  module  String
  action  String
  allowed Boolean

  @@unique([userId, module, action])
  @@index([module, action])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- Auditoría (inmutable desde operaciones ordinarias) ----------
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  // Módulo y severidad derivados del catálogo de acciones (ver @nexo/contracts).
  module     String?
  severity   String   @default("INFO")
  entityType String
  entityId   String?
  context    String? // JSON serializado (portabilidad SQLite/PostgreSQL)
  // Origen de la petición: quién y desde dónde se hizo el cambio.
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([module, createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

// ---------- Configuración del sistema ----------
model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// ---------- Sincronización con Profit ----------
model SyncRun {
  id              String    @id @default(cuid())
  // Domain: PRODUCTOS | CLIENTES | PEDIDOS | EXISTENCIAS | ALMACENES
  domain          String
  // Status: EN_CURSO | EXITOSA | PARCIAL | ERROR
  status          String    @default("EN_CURSO")
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  recordsRead     Int       @default(0)
  recordsUpserted Int       @default(0)
  errorsCount     Int       @default(0)
  errorDetail     String?
  sourceRef       String? // referencia a la vista/consulta de origen usada

  errors SyncError[]
}

model SyncError {
  id         String   @id @default(cuid())
  runId      String
  run        SyncRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  entity     String?
  externalId String?
  message    String
  raw        String?
  createdAt  DateTime @default(now())

  @@index([runId])
}

// ============================================================
// Entidades normalizadas desde Profit (Fase 2 — Integración)
// Conservan el identificador externo de Profit y marcan bajas
// con removedAt (nunca se borra histórico por una sync).
// ============================================================

model Product {
  id           String    @id @default(cuid())
  externalCode String    @unique
  description  String
  uom          String    @default("SAC")
  family       String?
  // Línea y categoría del artículo en Profit (co_lin / co_cat).
  // `isProduction` = pertenece a la línea de producción (ABA = balanceados).
  line         String?
  category     String?
  isProduction Boolean   @default(false)
  // kg por unidad de venta (columna `relacion_empaque` de la vista real:
  // 35 = saco de 35 KG). Permite reportar totales en KG/TON.
  kgPerUom     Decimal?
  isActive     Boolean   @default(true)
  removedAt    DateTime?
  lastSyncedAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orderLines    SalesOrderLine[]
  inventoryLines InventorySnapshotLine[]
}

model Warehouse {
  id           String    @id @default(cuid())
  externalCode String    @unique
  name         String
  isActive     Boolean   @default(true)
  removedAt    DateTime?
  lastSyncedAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inventoryLines InventorySnapshotLine[]
}

model Customer {
  id           String    @id @default(cuid())
  externalCode String    @unique
  name         String
  // L1 EXCLUSIVOS | COR CORPORATIVO | L2 DISTRIBUIDORES | L3 MINORISTA (crudo de Profit)
  customerType String?
  vendor       String?
  isActive     Boolean   @default(true)
  removedAt    DateTime?
  lastSyncedAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders SalesOrder[]
}

model SalesOrder {
  id             String    @id @default(cuid())
  externalNumber String    @unique
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerCode   String?
  customerName   String?
  customerType   String?
  vendor         String?
  orderDate      DateTime?
  requestedDate  DateTime?
  // ABIERTO | CERRADO | CANCELADO | DESCONOCIDO (mapeo desde statusRaw de Profit)
  status         String    @default("ABIERTO")
  statusRaw      String?
  authorized     Boolean?
  isActive       Boolean   @default(true)
  removedAt      DateTime?
  lastSyncedAt   DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines SalesOrderLine[]

  @@index([requestedDate])
  @@index([status])
}

model SalesOrderLine {
  id          String      @id @default(cuid())
  orderId     String
  order       SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNumber  Int
  productCode String
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id])
  description String?
  uom         String?
  // Cantidades DECIMAL: Precisiones de negocio (SAC con decimales). En PostgreSQL = NUMERIC.
  quantity    Decimal     @default(0)
  // Pendiente puede ser negativo en Profit (sobre-compromiso); conservar el signo.
  pendingQty  Decimal     @default(0)
  // kg del renglón según la vista (`kg` = pendiente × relacion_empaque,
  // calculado en Profit; se persiste el valor crudo, no se recalcula).
  pendingKg   Decimal?
  // Almacenes que surten el renglón (texto crudo, p. ej. "Stock 68 / Stock 03")
  warehouses  String?

  @@unique([orderId, lineNumber])
  @@index([productCode])
}

// Fotografía coherente de inventario por ejecución de sincronización.
// Fecha de entrega TENTATIVA por renglón de pedido (pedido + artículo).
// Es una capa local: NUNCA se escribe en Profit ni reemplaza requestedDate.
// La fecha original sigue viviendo en SalesOrder.requestedDate.
model DeliveryDateOverride {
  id            String   @id @default(cuid())
  orderNumber   String
  productCode   String
  customerCode  String?
  tentativeDate DateTime
  note          String?
  createdById   String?
  createdByCode String?
  updatedById   String?
  updatedByCode String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([orderNumber, productCode])
  @@index([customerCode])
  @@index([tentativeDate])
}

// Historial de cada asignación/restauración de fecha tentativa.
// `batchId` agrupa los cambios hechos en una misma acción masiva.
model DeliveryDateChange {
  id            String   @id @default(cuid())
  batchId       String?
  orderNumber   String
  productCode   String
  customerCode  String?
  previousDate  DateTime?
  newDate       DateTime?
  // SET | UPDATE | RESTORE
  action        String
  note          String?
  changedById   String?
  changedByCode String?
  changedAt     DateTime @default(now())

  @@index([changedAt])
  @@index([customerCode, changedAt])
  @@index([orderNumber, productCode])
}

model InventorySnapshot {
  id      String   @id @default(cuid())
  takenAt DateTime @default(now())
  // 'mssql' | 'fixtures'
  source  String
  runId   String?

  lines InventorySnapshotLine[]
}

model InventorySnapshotLine {
  id            String           @id @default(cuid())
  snapshotId    String
  snapshot      InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  productCode   String
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id])
  warehouseCode String
  warehouseId   String?
  warehouse     Warehouse?       @relation(fields: [warehouseId], references: [id])
  qty           Decimal          @default(0)
  reservedQty   Decimal          @default(0)

  @@index([snapshotId])
  @@index([productCode])
}

// ============================================================
// Forecast (pronóstico de producción).
//   Forecast      = cabecera por artículo/mes. `monthlyQty` guarda el valor
//                   de Profit (`xart_fore.kg_mes`) vigente cuando se editaron
//                   las semanas: sirve para detectar si Profit lo cambió.
//                   El mensual NO se captura en Nexo. `locked`/`lockedAt` se
//                   conservan por compatibilidad y ya no se usan.
//   ForecastWeek  = reparto por semana (bloques 1-7 / 8-14 / 15-21 / 22-fin)
//                   con una CANTIDAD editable. Por defecto = forecast mensual / 4.
// ============================================================
model Forecast {
  id          String    @id @default(cuid())
  productCode String
  year        Int
  month       Int
  monthlyQty  Decimal   @default(0)
  locked      Boolean   @default(false)
  lockedAt    DateTime?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  weeks ForecastWeek[]

  @@unique([productCode, year, month])
  @@index([year, month])
}

model ForecastWeek {
  id         String   @id @default(cuid())
  forecastId String
  forecast   Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  // 1..4 = bloques de días 1-7, 8-14, 15-21, 22-fin.
  weekIndex  Int
  // Cantidad asignada a la semana (por defecto = forecast mensual / 4).
  qty        Decimal  @default(0)

  @@unique([forecastId, weekIndex])
}

// ============================================================
// Simulador de despacho (Fase 6): escenarios guardados.
//
// Un escenario tiene dos capas:
//   · RECETA: agrupación, modo, orden, filtros y renglones marcados
//     (pedido#artículo). Al restaurar se vuelve a ejecutar el motor de
//     despacho con los datos de HOY.
//   · FOTO: totales y cantidades del momento de guardar, para mostrar el
//     diff («esto cambió») y comparar sin recalcular.
//
// `payload` es JSON serializado (portabilidad SQLite/PostgreSQL, igual que
// AuditEvent.context). NUNCA escribe en Profit: es una capa local de
// simulación.
//
// `kind = DRAFT` es el trabajo en curso del usuario (uno solo, `name = ''`);
// `kind = SAVED` son los guardados con nombre (máx. 25 por usuario).
// `dataVersion` = fingerprint de las últimas syncs de PEDIDOS y EXISTENCIAS
// para marcar el escenario como desactualizado sin releer Profit.
// ============================================================
model DispatchScenario {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  // DRAFT | SAVED
  kind        String   @default("SAVED")
  payload     String
  lineCount   Int      @default(0)
  sacks       Decimal  @default(0)
  assignedKg  Decimal  @default(0)
  missingKg   Decimal  @default(0)
  // Cobertura en % (0-100), derivada de la foto al guardar.
  coverage    Int      @default(0)
  dataVersion String?
  // Versionado optimista: el cliente envía la versión que leyó.
  version     Int      @default(1)
  restoredAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Un borrador por usuario (name vacío) y nombres únicos por usuario.
  @@unique([ownerId, kind, name])
  @@index([ownerId, updatedAt])

  restores DispatchScenarioRestore[]
}

// Historial visible de restauraciones de un escenario del simulador.
// Guarda el diff que el cliente calculó antes de confirmar: así el usuario ve
// «qué cambió» la última vez, no solo que «se restauró».
model DispatchScenarioRestore {
  id             String           @id @default(cuid())
  scenarioId     String
  scenario       DispatchScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  restoredById   String?
  restoredByCode String?
  restoredByName String?
  restoredAt     DateTime         @default(now())
  // Renglones aplicados y renglones que ya no estaban en la cartera.
  restored       Int              @default(0)
  missing        Int              @default(0)
  pendingChanges Int              @default(0)
  stockChanges   Int              @default(0)
  dateChanges    Int              @default(0)
  carteraBefore  Int              @default(0)
  carteraAfter   Int              @default(0)
  beforeKg       Decimal          @default(0)
  afterKg        Decimal          @default(0)
  // 0..1
  beforeCoverage Decimal          @default(0)
  afterCoverage  Decimal          @default(0)
  note           String?

  @@index([scenarioId, restoredAt])
}

// ============================================================
// Despacho de almacén (Fase 6b): hoja de despacho + túnel de acuses.
//
// Nace de un escenario guardado del simulador (`scenarioId`). El planificador
// lo publica, el almacén lo recibe, lo carga renglón por renglón y lo cierra;
// cada paso deja sello temporal, evento en la bitácora y notificación al otro
// lado. `status` sigue una máquina de estados validada en el servicio.
//
// Nombres de personas DENORMALIZADOS (createdBy*/claimedBy*/receivedBy*/
// completedBy*): la bitácora es histórica y debe sobrevivir a cambios de rol
// o bajas del usuario. Solo `assignedTo` es relación (se filtra y notifica).
// ============================================================
model DispatchSheet {
  id             String    @id @default(cuid())
  // Correlativo legible: DSP-2026-0001.
  number         String    @unique
  title          String
  // ENVIADO | RECIBIDO | EN_PROCESO | CON_NOVEDAD | DESPACHADO | CANCELADO
  status         String    @default("ENVIADO")
  instructions   String?
  // Origen: escenario del simulador (receta + foto para comparar).
  scenarioId     String?
  scenarioName   String?
  recipeJson     String?
  photoJson      String?

  assignedToId   String?
  assignedTo     User?     @relation("SheetAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedRole   String    @default("ALMACEN")

  claimedById    String?
  claimedByCode  String?
  claimedByName  String?
  claimedAt      DateTime?

  createdById    String
  createdByCode  String?
  createdByName  String?

  sentAt         DateTime  @default(now())
  receivedAt     DateTime?
  receivedById   String?
  receivedByName String?
  startedAt      DateTime?
  completedAt    DateTime?
  completedById  String?
  completedByName String?
  canceledAt     DateTime?
  canceledById   String?
  canceledByName String?
  cancelReason   String?

  plannedLines   Int       @default(0)
  plannedSacks   Decimal   @default(0)
  plannedKg      Decimal   @default(0)
  loadedSacks    Decimal   @default(0)
  loadedKg       Decimal   @default(0)
  differenceKg   Decimal   @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines  DispatchSheetLine[]
  events DispatchSheetEvent[]
  arrivals CustomerArrival[]

  @@index([status, sentAt])
  @@index([assignedToId, status])
  @@index([createdById, status])
}

model DispatchSheetLine {
  id            String        @id @default(cuid())
  sheetId       String
  sheet         DispatchSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  // Turno/orden de carga que traía el plan de despacho.
  position      Int
  orderNumber   String
  productCode   String
  description   String?
  uom           String?
  customerCode  String?
  customerName  String?
  // Stock 03 | Stock 68 | Stock 9999
  warehouseCode String?
  // yyyy-MM-dd (texto: sin zonas horarias en fechas de negocio).
  effectiveDate String?
  plannedQty    Decimal       @default(0)
  plannedKg     Decimal       @default(0)
  // Lo que el almacén cargó de verdad.
  loadedQty     Decimal?
  loadedKg      Decimal?
  // PENDIENTE | CARGADO (marcas actuales)
  // PARCIAL | FALTANTE | NOVEDAD quedan solo como histórico de lectura.
  status        String        @default("PENDIENTE")
  note          String?
  checkedAt     DateTime?
  checkedById   String?
  checkedByName String?

  @@unique([sheetId, orderNumber, productCode])
  @@index([sheetId, position])
}

model DispatchSheetEvent {
  id         String        @id @default(cuid())
  sheetId    String
  sheet      DispatchSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  // SYSTEM = transición de estado; MESSAGE = conversación entre las partes.
  kind       String
  type       String
  body       String?
  authorId   String?
  authorCode String?
  authorName String?
  createdAt  DateTime      @default(now())

  @@index([sheetId, createdAt])
}

// ============================================================
// Llegadas de clientes (PCP)
//
// Se crean solas al publicar un despacho (`DispatchSheet`), un registro por
// cliente. En planta se marca la hora de llegada con el reloj del servidor y
// se reportan incidencias. `number` es el correlativo legible LLG-AAAA-NNNN.
// Nombres denormalizados: la bitácora es histórica y no depende de que el
// usuario siga activo.
// ============================================================
model CustomerArrival {
  id             String        @id @default(cuid())
  number         String        @unique
  sheetId        String
  sheet          DispatchSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  // Copia del despacho al momento de crear la llegada (histórico).
  sheetNumber    String
  sheetTitle     String

  customerCode   String
  customerName   String
  // yyyy-MM-dd: fecha de entrega más próxima del cliente dentro del plan.
  expectedDate   String?
  // Pedidos del cliente incluidos en el despacho (CSV, para búsqueda y hoja).
  orderNumbers   String
  lineCount      Int           @default(0)
  plannedSacks   Decimal       @default(0)
  plannedKg      Decimal       @default(0)

  // ESPERADO | EN_PLANTA | ATENDIDO | AUSENTE | CON_INCIDENCIA | CANCELADO
  status         String        @default("ESPERADO")
  arrivedAt      DateTime?
  arrivedById    String?
  arrivedByCode  String?
  arrivedByName  String?
  closedAt       DateTime?
  note           String?

  createdById    String?
  createdByCode  String?
  createdByName  String?
  updatedById    String?
  updatedByName  String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  incidents ArrivalIncident[]
  events    ArrivalEvent[]

  @@unique([sheetId, customerCode])
  @@index([status, expectedDate])
  @@index([arrivedAt])
}

model ArrivalIncident {
  id             String          @id @default(cuid())
  arrivalId      String
  arrival        CustomerArrival @relation(fields: [arrivalId], references: [id], onDelete: Cascade)
  // FALTANTE | DEMORA | DANO | DOCUMENTO | RECHAZO | OTRO
  kind           String
  // BAJA | MEDIA | ALTA
  severity       String          @default("MEDIA")
  body           String
  // ABIERTA | RESUELTA
  status         String          @default("ABIERTA")
  resolution     String?

  reportedById   String?
  reportedByCode String?
  reportedByName String?
  resolvedById   String?
  resolvedByName String?
  resolvedAt     DateTime?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([arrivalId, status])
}

model ArrivalEvent {
  id         String          @id @default(cuid())
  arrivalId  String
  arrival    CustomerArrival @relation(fields: [arrivalId], references: [id], onDelete: Cascade)
  // SYSTEM = hito del proceso; MESSAGE = nota libre de la contraparte.
  kind       String          @default("SYSTEM")
  type       String
  body       String?
  authorId   String?
  authorCode String?
  authorName String?
  createdAt  DateTime        @default(now())

  @@index([arrivalId, createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String?
  entityType  String
  entityId    String
  linkPath    String
  actorId     String?
  actorName   String?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId, readAt, createdAt])
}
