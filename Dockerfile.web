# ============================================================
# Web Next.js en modo standalone (solo Docker/Linux).
# API_URL se fija en el BUILD porque los rewrites de Next se compilan.
# ============================================================
FROM node:22-bookworm-slim AS builder

RUN apt-get update -y \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@11.24.0

WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

ARG API_URL=http://api:4000
ENV API_URL=$API_URL
ENV NEXT_STANDALONE=1
ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm --filter @nexo/web build

FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production
ENV PORT=4100
# En Docker HOSTNAME es el id del contenedor; Next debe escuchar en todas las
# interfaces para que el puerto publicado funcione.
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 4100

CMD ["sh", "-c", "if [ -f apps/web/server.js ]; then node apps/web/server.js; else node server.js; fi"]
