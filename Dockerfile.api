# ============================================================
# API NestJS + Prisma (PostgreSQL en producción).
# El esquema fuente es prisma/schema.prisma (SQLite para desarrollo); aquí se
# genera una copia con provider="postgresql" para no mantener dos archivos.
# ============================================================
FROM node:22-bookworm-slim

RUN apt-get update -y \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@11.24.0

WORKDIR /app

# Contexto = raíz del monorepo (respeta .dockerignore).
COPY . .

RUN pnpm install --frozen-lockfile

WORKDIR /app/apps/api

# Esquema de producción + cliente Prisma + build de Nest.
RUN sed 's/provider = "sqlite"/provider = "postgresql"/' prisma/schema.prisma > prisma/schema.docker.prisma \
 && pnpm exec prisma generate --schema prisma/schema.docker.prisma \
 && pnpm build

ENV NODE_ENV=production

EXPOSE 4000

# `db push` es aditivo: si detecta un cambio destructivo falla, no borra datos.
CMD ["sh", "-c", "pnpm exec prisma db push --schema prisma/schema.docker.prisma --skip-generate && node dist/main.js"]
