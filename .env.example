# ============================================================
# Nexo Producción — Variables de entorno (ejemplo)
# NUNCA versionar el archivo .env real ni commitear secretos.
# ============================================================

# ---------- Entorno ----------
NODE_ENV=development
API_PORT=4000
WEB_PORT=4100
# URL de la API para el proxy de Next (/api/* → API_URL/api/*).
# En dev local la API corre en 4010 (el 4000 está ocupado en la máquina):
# definir API_URL=http://localhost:4010 en apps/web/.env.local (no versionado).
API_URL=http://localhost:4010
APP_URL=http://localhost:4100
LOG_LEVEL=info

# ---------- Base de datos interna (Prisma) ----------
# Desarrollo: SQLite (file:./nexo.db). Producción: PostgreSQL.
DATABASE_URL="file:./nexo.db"
# Producción:
# DATABASE_URL="postgresql://user:password@host:5432/nexo_produccion?schema=public"

# ---------- Autenticación ----------
JWT_SECRET=cambie-este-secreto-en-produccion
JWT_REFRESH_SECRET=cambie-este-secreto-de-refresh-en-produccion
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---------- Conexión Profit (SQL Server, SOLO LECTURA) ----------
# Misma forma de variables que Data-Maestra / Taller.
PROFIT_DB_SERVER=SRVBDPROFITBK
# Corp. Agropecuaria Venezolana: la vista real vive en COR_A3.
PROFIT_DB_DATABASE=COR_A3
PROFIT_DB_USER=solicitudweb
PROFIT_DB_PASSWORD=
# 'mssql' = conexión real a SQL Server; 'fixtures' = datos de desarrollo deterministas
PROFIT_DB_DIALECT=fixtures
# Timeout y reintentos del adaptador
PROFIT_DB_REQUEST_TIMEOUT_MS=30000
PROFIT_DB_MAX_RETRIES=2

# Única vista de origen: una fila = un renglón de solicitud
# (pedido + cliente + artículo + pendiente + existencias Stock_03/Stock_68).
# Todas las corridas de sync derivan sus dominios de esta vista.
PROFIT_VIEW_SOLICITUDES=dbo.Solicitudes_Pendientes_Clientes

# ---------- Escritura puntual en Profit (entrega + bloqueo) ----------
# Excepción controlada a la regla de solo lectura: SOLO dbo.cotiz_c.fec_venc
# (entrega) y dbo.cotiz_c.aux01 (bloqueo al iniciar la carga).
# Queda ACTIVA por defecto cuando hay credenciales SQL; `false` es el kill
# switch explícito. El cambio se firma con el código de la sesión (co_us_mo).
PROFIT_WRITE_ENABLED=true
# Vacío = reutiliza PROFIT_DB_USER / PROFIT_DB_PASSWORD.
PROFIT_WRITE_USER=
PROFIT_WRITE_PASSWORD=
# true = valida todo pero NO escribe en Profit (solo para simulacros).
PROFIT_WRITE_DRY_RUN=false
# Tope de pedidos por operación (protege contra un lote accidental).
PROFIT_WRITE_MAX_ORDERS=50

# ---------- Sincronización ----------
# Corrida COMPLETA cada N segundos (0 = desactivado). Es el modo simple.
SYNC_INTERVAL_SECONDS=0
# Reloj POR DOMINIO: la forma sostenible. Cada dominio se refresca a su ritmo,
# así lo volátil (existencias/pedidos) está fresco y el catálogo (productos,
# ~17 s de lectura en la vista real) no castiga el SQL Server de Profit.
# Recomendado en producción (segundos):
#   EXISTENCIAS=120,PEDIDOS=300,PEDIDOS_DETALLE=300,CLIENTES=3600,PRODUCTOS=21600,ALMACENES=86400
# Vacío = solo sincronización manual (botón «Sincronizar» / POST /api/sync/run-all).
# Piso de seguridad por dominio: 60 s.
SYNC_SCHEDULE=
# Fotografías de inventario que se conservan (las viejas se podan en cada
# corrida de EXISTENCIAS para que la base no crezca sin techo).
SYNC_SNAPSHOT_RETENTION=240
SYNC_PAGE_SIZE=5000

# ---------- Reconciliación de pedidos (nota de entrega) ----------
# Cierra en Nexo los pedidos que Profit convirtió en nota de entrega.
# ORDER_RECONCILE_DRY_RUN=true calcula sin escribir (útil en la primera puesta
# en marcha). El scheduler corre cada ORDER_RECONCILE_SECONDS (mínimo 60).
ORDER_RECONCILE_ENABLED=true
ORDER_RECONCILE_SECONDS=300
ORDER_RECONCILE_DRY_RUN=false
ORDER_RECONCILE_BATCH_SIZE=200

# ---------- Limpieza de simulaciones de despacho ----------
# Las simulaciones guardadas son fotos de vida corta: la hoja de despacho ya
# copió nombre, foto y receta. Se borran solas a las SCENARIO_CLEANUP_HOURS
# (72 h) sin uso, con traza en la bitácora. DRY_RUN=true calcula sin borrar.
SCENARIO_CLEANUP_ENABLED=true
SCENARIO_CLEANUP_HOURS=72
SCENARIO_CLEANUP_INTERVAL_HOURS=6
SCENARIO_CLEANUP_DRY_RUN=false

# ---------- Romana (báscula) ----------
# Fotos de cédula y carnet por pedido. El archivo vive en un volumen; la base
# solo guarda metadatos. Al validar se borran las fotos.
ROMANA_UPLOAD_DIR=uploads/romana
ROMANA_MAX_UPLOAD_MB=12
# Fotos que nunca se validaron se borran a los N días (168 h = 7 días).
ROMANA_RETENTION_HOURS=168
ROMANA_CLEANUP_ENABLED=true
ROMANA_CLEANUP_INTERVAL_HOURS=6
ROMANA_CLEANUP_DRY_RUN=false

# ---------- Forecast (pronóstico de producción) ----------
# El forecast mensual se lee de Profit (`dbo.forecast`: `fecha` = mes de
# vigencia; `kg_mensual` viene en la presentación del artículo y se convierte a
# kg con `art.uni_relac` cuando es SAC); en Nexo solo se editan las cantidades
# por semana. (Artículos: línea ABA.)
# Snapshot local de la meta para que el histórico no cambie si producción edita
# `forecast` después. Minutos entre capturas; 0 = desactivado (se puede forzar
# con POST /api/forecast/sales/capture).
FORECAST_TARGET_INTERVAL_MINUTES=60
# Horas de gracia para corregir la primera captura del mes (producción puede
# cargar la meta unos días después). Después queda congelada.
FORECAST_TARGET_GRACE_HOURS=72

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:4100

# ---------- Espejo de la BD local (solo desarrollo) ----------
# 1 = habilita GET/POST /api/dev/db-mirror y el botón «Restaurar desde main»
# en Usuarios → Bitácoras. NUNCA activar en producción (el módulo tampoco se
# registra con NODE_ENV=production).
DB_MIRROR_ENABLED=0
# Opcional: ruta explícita del .db del worktree main. Si se omite, se detecta
# con `git worktree list` (rama main).
# DB_MIRROR_SOURCE=C:/ruta/a/Reportes/apps/api/prisma/nexo.db

