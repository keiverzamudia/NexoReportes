# ============================================================
# Nexo Producción — Variables de entorno (ejemplo)
# NUNCA versionar el archivo .env real ni commitear secretos.
# ============================================================

# ---------- Entorno ----------
NODE_ENV=development
API_PORT=4000
WEB_PORT=4100
APP_URL=http://localhost:4100
LOG_LEVEL=info

# ---------- Base de datos interna (Prisma) ----------
# Desarrollo: SQLite (file:./nexo.db). Producción: PostgreSQL.
DATABASE_URL="file:./nexo.db"
# Producción:
# DATABASE_URL="postgresql://user:password@host:5432/nexo_produccion?schema=public"

# ---------- Autenticación ----------
JWT_SECRET=cambie-este-secreto-en-produccion
JWT_REFRESH_SECRET=cambie-este-secreto-de-refresh-en-produccion
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---------- Conexión Profit (SQL Server, SOLO LECTURA) ----------
# Misma forma de variables que Data-Maestra / Taller.
PROFIT_DB_SERVER=SRVBDPROFITBK
PROFIT_DB_DATABASE=AD_TRANS
PROFIT_DB_USER=solicitudweb
PROFIT_DB_PASSWORD=
# 'mssql' = conexión real a SQL Server; 'fixtures' = datos de desarrollo deterministas
PROFIT_DB_DIALECT=fixtures
# Timeout y reintentos del adaptador
PROFIT_DB_REQUEST_TIMEOUT_MS=30000
PROFIT_DB_MAX_RETRIES=2

# Nombres de vistas/tablas de Profit (CONFIGURABLES — confirmar con las vistas reales)
PROFIT_VIEW_PRODUCTOS=
PROFIT_VIEW_CLIENTES=
PROFIT_VIEW_PEDIDOS=
PROFIT_VIEW_PEDIDOS_DETALLE=
PROFIT_VIEW_EXISTENCIAS=
PROFIT_VIEW_ALMACENES=

# ---------- Sincronización ----------
# Intervalo en segundos para el worker (0 = desactivado; ejecución manual vía API)
SYNC_INTERVAL_SECONDS=0
SYNC_PAGE_SIZE=5000

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:4100
